{
  "name": "cmmi5-analyzer",
  "version": "1.0.1",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "set ELECTRON_IS_DEV=true && electron .",
    "electron:prod": "electron .",
    "build:electron": "ng build --base-href ./",
    "make:installer": "npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.ope.cmmi5analyzer",
    "productName": "CMMI5 Analyzer",
    "copyright": "Copyright © 2024 OPE",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "dist/cmmi5-analyzer/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@lucide/angular": "^1.14.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "electron-updater": "^6.8.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2"
  }
}